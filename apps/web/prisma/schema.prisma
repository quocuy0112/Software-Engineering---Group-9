generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountState {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum TokenStatus {
  ACTIVE
  CONSUMED
  SUPERSEDED
  EXPIRED
}

enum ChallengePurpose {
  PASSWORD_LOGIN_2FA
  RECENT_AUTH
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum EmailKind {
  VERIFY_EMAIL
  RESET_PASSWORD
  PASSWORD_CHANGED
  SECURITY_ALERT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  RETRYABLE
  DEAD
}

model UserAccount {
  id                String                    @id
  name              String
  email             String                    @unique
  normalizedEmail   String                    @unique
  emailVerified     Boolean                   @default(false)
  image             String?
  state             AccountState              @default(PENDING_VERIFICATION)
  twoFactorEnabled  Boolean                   @default(false)
  stateChangedAt    DateTime                  @default(now())
  deletedAt         DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  accounts          AuthProviderAccount[]
  sessions          Session[]
  verifications     Verification[]
  twoFactor         TwoFactor?
  candidateIdentity CandidateIdentity?
  securityTokens    SecurityToken[]
  challenges        AuthenticationChallenge[]
  outbox            EmailOutbox[]

  @@index([state, id])
  @@map("user")
}

model AuthProviderAccount {
  id                    String      @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  user                  UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id                String      @id
  token             String      @unique
  userId            String
  expiresAt         DateTime
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  ipAddress         String?
  userAgent         String?
  lastActivityAt    DateTime    @default(now())
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revocationReason  String?
  user              UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, lastActivityAt])
  @@index([absoluteExpiresAt])
  @@map("session")
}

model Verification {
  id         String       @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  userId     String?
  user       UserAccount? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String      @id
  secret      String
  backupCodes String
  userId      String      @unique
  verified    Boolean     @default(true)
  user        UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("twoFactor")
}

model CandidateIdentity {
  userId    String      @id
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model SecurityToken {
  id                 String        @id @default(cuid())
  userId             String
  purpose            TokenPurpose
  status             TokenStatus   @default(ACTIVE)
  tokenDigest        String        @unique
  expiresAt          DateTime
  consumedAt         DateTime?
  supersededAt       DateTime?
  createdAt          DateTime      @default(now())
  createdByRequestId String
  user               UserAccount   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox             EmailOutbox[]

  @@index([expiresAt, status])
  @@index([userId, purpose, status])
}

model AuthenticationChallenge {
  id            String           @id @default(cuid())
  handleDigest  String           @unique
  userId        String
  purpose       ChallengePurpose
  expiresAt     DateTime
  attemptCount  Int              @default(0)
  maxAttempts   Int              @default(5)
  consumedAt    DateTime?
  contextDigest String?
  createdAt     DateTime         @default(now())
  user          UserAccount      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([handleDigest, expiresAt])
  @@index([userId, expiresAt])
}

model RateLimitBucket {
  scope         String
  subjectDigest String
  windowStart   DateTime
  count         Int       @default(0)
  blockedUntil  DateTime?
  updatedAt     DateTime  @updatedAt

  @@id([scope, subjectDigest, windowStart])
  @@index([blockedUntil])
}

model EmailOutbox {
  id                String         @id @default(cuid())
  kind              EmailKind
  userId            String?
  securityTokenId   String?
  recipientRef      String
  templateVersion   String
  payloadRef        Json
  idempotencyKey    String         @unique
  status            OutboxStatus   @default(PENDING)
  attempts          Int            @default(0)
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  nextAttemptAt     DateTime       @default(now())
  providerMessageId String?
  safeErrorCode     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              UserAccount?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  securityToken     SecurityToken? @relation(fields: [securityTokenId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model AuditEvent {
  id              String      @id @default(cuid())
  occurredAt      DateTime    @default(now())
  actorType       String
  actorUserId     String?
  actorSessionId  String?
  action          String
  targetType      String
  targetId        String?
  result          AuditResult
  correlationId   String
  ipPrefixDigest  String?
  userAgentFamily String?
  context         Json

  @@index([actorUserId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([action, occurredAt])
  @@index([correlationId])
}
