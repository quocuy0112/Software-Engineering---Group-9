FROM node:24.18.0-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY web/package.json web/package.json
RUN npm ci --omit=dev --ignore-scripts --workspace @smarthire/web
COPY web web
RUN install -d -o node -g node -m 0700 /app/.local/admin-evidence
USER node
CMD ["npm", "run", "admin:worker", "--workspace", "@smarthire/web"]
