FROM node:24.18.0-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS dependencies

WORKDIR /app

COPY package.json package-lock.json ./
COPY web/package.json ./web/package.json
RUN npm ci --ignore-scripts && npm prune --omit=dev --ignore-scripts

FROM node:24.18.0-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS runtime

WORKDIR /app

ENV NODE_ENV=development \
    CV_STORAGE_LOCAL_ROOT=/app/.local/cv-storage \
    CV_CLAMD_SOCKET_PATH=/run/clamav/clamd.sock

RUN rm -rf \
    /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack \
    /usr/local/bin/pnpm \
    /usr/local/bin/pnpx \
    /usr/local/bin/yarn \
    /usr/local/bin/yarnpkg

RUN install -d -o node -g node -m 0700 /app/.local/cv-storage

WORKDIR /app/web
COPY --from=dependencies --chown=node:node /app/node_modules /app/node_modules
COPY --from=dependencies --chown=node:node /app/web/node_modules /app/web/node_modules
COPY --chown=node:node package.json /app/package.json
COPY --chown=node:node web/package.json web/tsconfig.json web/prisma.config.ts ./
COPY --chown=node:node web/prisma ./prisma
COPY --chown=node:node web/scripts ./scripts
COPY --chown=node:node web/src ./src
USER node

CMD ["node", "--conditions=react-server", "--import", "tsx", "scripts/run-cv-worker.mjs"]
