model AdminDashboardSnapshot {
  id                     String   @id @default(cuid())
  calculatedAt           DateTime
  expiresAt              DateTime
  stateDefinitionVersion String
  metrics                Json
  createdAt              DateTime @default(now())

  @@index([expiresAt, calculatedAt(sort: Desc)])
}

model ModerationReport {
  id                     String                    @id @default(cuid())
  reporterUserId         String
  targetType             ModerationTargetType
  targetReference        String
  companyReference       String?
  jobReference           String?
  applicationReference   String?
  qualifyingRelationship Json
  category               ModerationReportCategory
  normalizedDetail       String?
  priority               ModerationPriority        @default(NORMAL)
  state                  ModerationReportState     @default(PENDING_REVIEW)
  assignedAdminUserId    String?
  unresolvedKey          String?                   @unique
  version                Int                       @default(1)
  terminalAt             DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  reporter               UserAccount               @relation("ModerationReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  history                ModerationReportHistory[]
  notes                  ModerationPrivateNote[]

  @@index([state, priority, createdAt, id])
  @@index([reporterUserId, createdAt(sort: Desc)])
  @@index([targetType, targetReference])
}

model ModerationReportHistory {
  id                       String                @id @default(cuid())
  reportId                 String
  actorAdminUserId         String
  action                   String
  priorState               ModerationReportState
  resultingState           ModerationReportState
  resultingVersion         Int
  enforcementCorrelationId String?
  occurredAt               DateTime              @default(now())
  report                   ModerationReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, resultingVersion])
  @@index([actorAdminUserId, occurredAt])
}

model ModerationPrivateNote {
  id                String           @id @default(cuid())
  reportId          String
  authorAdminUserId String
  normalizedText    String
  createdAt         DateTime         @default(now())
  report            ModerationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

model JobPosting {
  id                       String                @id @default(cuid())
  companyId                String
  slug                     String                @unique
  title                    String
  normalizedTitle          String
  summary                  String
  description              String
  responsibilities         String
  requirements             String
  benefits                 String?
  education                String?
  numberOfHires            Int?
  age                      String?
  location                 String
  normalizedLocation       String
  employmentType           EmploymentType
  experienceLevel          ExperienceLevel
  workArrangement          WorkArrangement
  salaryMin                Decimal?              @db.Decimal(14, 2)
  salaryMax                Decimal?              @db.Decimal(14, 2)
  salaryCurrency           String?               @db.VarChar(3)
  salaryPeriod             SalaryPeriod?
  searchDocumentNormalized String                @db.Text
  status                   JobPostingStatus      @default(DRAFT)
  approvedAt               DateTime?
  publishedAt              DateTime?
  applicationDeadline      DateTime?
  closedAt                 DateTime?
  removedAt                DateTime?
  version                  Int                   @default(1)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  company                  Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  skills                   JobPostingSkill[]
  questions                ApplicationQuestion[]
  savedBy                  SavedJob[]
  reports                  JobReport[]
  applications             JobApplication[]

  @@index([status, publishedAt(sort: Desc), id])
  @@index([status, applicationDeadline, id])
  @@index([employmentType, experienceLevel, workArrangement])
  @@index([salaryCurrency, salaryPeriod, salaryMax(sort: Desc), id])
  @@index([companyId, status, id])
  @@index([normalizedTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "JobPosting_normalizedTitle_trgm_idx")
  @@index([normalizedLocation(ops: raw("gin_trgm_ops"))], type: Gin, map: "JobPosting_normalizedLocation_trgm_idx")
  @@index([searchDocumentNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "JobPosting_searchDocumentNormalized_trgm_idx")
}

model JobPostingSkill {
  jobPostingId String
  skillId      String
  displayName  String
  required     Boolean    @default(false)
  position     Int
  createdAt    DateTime   @default(now())
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([jobPostingId, skillId])
  @@unique([jobPostingId, position])
  @@index([skillId, jobPostingId])
}

model ApplicationQuestion {
  id           String                  @id @default(cuid())
  jobPostingId String
  prompt       String
  description  String?
  kind         ApplicationQuestionKind
  required     Boolean                 @default(false)
  options      Json?
  position     Int
  version      Int                     @default(1)
  active       Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  jobPosting   JobPosting              @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  answers      ApplicationAnswer[]

  @@unique([jobPostingId, position])
  @@index([jobPostingId, active, position])
}

model CandidateCv {
  id              String            @id @default(cuid())
  candidateUserId String
  displayName     String
  fileName        String
  mimeType        String
  byteSize        Int
  storageKey      String            @unique
  checksumSha256  String
  version         Int               @default(1)
  confirmedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  candidate       CandidateIdentity @relation(fields: [candidateUserId], references: [userId], onDelete: Restrict)
  applications    JobApplication[]

  @@index([candidateUserId, confirmedAt, archivedAt])
}

model SavedJob {
  userId       String
  jobPostingId String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting   JobPosting  @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)

  @@id([userId, jobPostingId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([jobPostingId])
}

model JobReport {
  id             String          @id @default(cuid())
  reporterUserId String
  jobPostingId   String
  reason         JobReportReason
  details        String?
  status         JobReportStatus @default(PENDING_REVIEW)
  unresolvedKey  String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  resolvedAt     DateTime?
  reporter       UserAccount     @relation(fields: [reporterUserId], references: [id], onDelete: Restrict)
  jobPosting     JobPosting      @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)

  @@index([jobPostingId, status, createdAt])
  @@index([reporterUserId, createdAt(sort: Desc)])
}

model JobApplication {
  id                      String                        @id @default(cuid())
  candidateUserId         String
  jobPostingId            String
  selectedCvId            String
  cvFileRef               String?
  contactSnapshot         Json?
  aiAnalysisConsent       Boolean                       @default(false)
  aiMatchScore            Int?
  scoringStatus           ApplicationScoringStatus      @default(NOT_REQUESTED)
  stage                   ApplicationStage              @default(APPLIED)
  stageVersion            Int                           @default(1)
  lastStageChangedAt      DateTime                      @default(now())
  coverLetter             String?
  profileSnapshot         Json
  cvSnapshot              Json
  jobSnapshot             Json
  consentVersion          String
  consentedAt             DateTime
  idempotencyKey          String
  submissionBindingDigest String
  submittedAt             DateTime                      @default(now())
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  candidate               CandidateIdentity             @relation(fields: [candidateUserId], references: [userId], onDelete: Restrict)
  jobPosting              JobPosting                    @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  selectedCv              CandidateCv                   @relation(fields: [selectedCvId], references: [id], onDelete: Restrict)
  answers                 ApplicationAnswer[]
  notificationWork        RecruitmentNotificationWork[]
  stageEvents             ApplicationStageEvent[]
  messagingConversations  MessagingConversation[]

  @@unique([candidateUserId, jobPostingId])
  @@unique([candidateUserId, idempotencyKey])
  @@index([jobPostingId, stage, submittedAt])
  @@index([candidateUserId, submittedAt(sort: Desc)])
  @@index([candidateUserId, aiAnalysisConsent])
}

model ProfessionalConnection {
  id                 String                               @id @default(cuid())
  participantLowId   String
  participantHighId  String
  sourceProposalId   String?                              @unique
  state              ProfessionalConnectionStatus         @default(ACCEPTED)
  version            Int                                  @default(1)
  acceptedAt         DateTime                             @default(now())
  revokedAt          DateTime?
  revokedByUserId    String?
  createdAt          DateTime                             @default(now())
  updatedAt          DateTime                             @updatedAt
  participantLow     UserAccount                          @relation("ProfessionalConnectionLow", fields: [participantLowId], references: [id], onDelete: Restrict)
  participantHigh    UserAccount                          @relation("ProfessionalConnectionHigh", fields: [participantHighId], references: [id], onDelete: Restrict)
  sourceProposal     ProfessionalConnectionProposal?      @relation(fields: [sourceProposalId], references: [id], onDelete: SetNull)
  revokedBy          UserAccount?                         @relation("ProfessionalConnectionRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  conversations      MessagingConversation[]
  notifications      ProfessionalConnectionNotification[]
  notificationOutbox EmailOutbox[]

  @@index([participantHighId, participantLowId, state])
}

model ProfessionalConnectionProposal {
  id                          String                                  @id @default(cuid())
  participantLowId            String?
  participantHighId           String?
  participantPairDigest       String                                  @db.VarChar(128)
  createdByAdminUserId        String?
  sourceSupportConversationId String?
  reason                      String?                                 @db.VarChar(500)
  state                       ProfessionalConnectionProposalState     @default(PENDING_BOTH)
  expiresAt                   DateTime
  version                     Int                                     @default(1)
  terminalAt                  DateTime?
  ordinaryDetailHiddenAt      DateTime?
  protectedDeleteAfter        DateTime?
  protectedDeletedAt          DateTime?
  createdAt                   DateTime                                @default(now())
  updatedAt                   DateTime                                @updatedAt
  participantLow              UserAccount?                            @relation("ConnectionProposalLow", fields: [participantLowId], references: [id], onDelete: SetNull)
  participantHigh             UserAccount?                            @relation("ConnectionProposalHigh", fields: [participantHighId], references: [id], onDelete: SetNull)
  createdByAdmin              UserAccount?                            @relation("ConnectionProposalCreator", fields: [createdByAdminUserId], references: [id], onDelete: SetNull)
  sourceSupportConversation   SupportConversation?                    @relation(fields: [sourceSupportConversationId], references: [id], onDelete: SetNull)
  decisions                   ProfessionalConnectionDecision[]
  history                     ProfessionalConnectionProposalHistory[]
  connection                  ProfessionalConnection?
  notifications               ProfessionalConnectionNotification[]
  notificationOutbox          EmailOutbox[]

  @@index([participantLowId, state, expiresAt, id])
  @@index([participantHighId, state, expiresAt, id])
  @@index([createdByAdminUserId, createdAt])
  @@index([participantLowId, participantHighId, terminalAt])
  @@index([expiresAt, state])
  @@index([protectedDeleteAfter, protectedDeletedAt])
}

model ProfessionalConnectionDecision {
  proposalId        String
  participantUserId String
  decision          ProfessionalConnectionDecisionKind
  version           Int                                @default(1)
  decidedAt         DateTime                           @default(now())
  proposal          ProfessionalConnectionProposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  participant       UserAccount                        @relation("ConnectionProposalDecisionParticipant", fields: [participantUserId], references: [id], onDelete: Restrict)

  @@id([proposalId, participantUserId])
  @@index([participantUserId, decidedAt])
}

model ProfessionalConnectionProposalHistory {
  id               String                               @id @default(cuid())
  proposalId       String
  actorUserId      String?
  action           String                               @db.VarChar(80)
  priorState       ProfessionalConnectionProposalState?
  resultingState   ProfessionalConnectionProposalState
  resultingVersion Int
  decisionKind     ProfessionalConnectionDecisionKind?
  correlationId    String                               @db.VarChar(128)
  occurredAt       DateTime                             @default(now())
  proposal         ProfessionalConnectionProposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  actor            UserAccount?                         @relation("ConnectionProposalHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([proposalId, occurredAt, id])
  @@index([correlationId])
}

model ProfessionalConnectionNotification {
  id               String                                 @id @default(cuid())
  recipientUserId  String
  proposalId       String?
  connectionId     String?
  kind             ProfessionalConnectionNotificationKind
  deduplicationKey String                                 @unique
  readAt           DateTime?
  deleteAfter      DateTime
  createdAt        DateTime                               @default(now())
  recipient        UserAccount                            @relation("ConnectionNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  proposal         ProfessionalConnectionProposal?        @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  connection       ProfessionalConnection?                @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, createdAt(sort: Desc), id])
  @@index([deleteAfter])
}

model ProfessionalConnectionCommandReceipt {
  id              String      @id @default(cuid())
  actorUserId     String
  idempotencyKey  String
  commandKind     String      @db.VarChar(80)
  targetReference String?     @db.VarChar(128)
  payloadDigest   String      @db.VarChar(128)
  resultReference String?     @db.VarChar(128)
  resultState     String?     @db.VarChar(80)
  resultVersion   Int?
  createdAt       DateTime    @default(now())
  actor           UserAccount @relation("ConnectionCommandActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, idempotencyKey])
  @@index([targetReference, createdAt])
}

model SupportConversation {
  id                    String                           @id @default(cuid())
  requesterUserId       String
  category              SupportConversationCategory
  subject               String                           @db.VarChar(120)
  state                 SupportConversationState         @default(OPEN)
  version               Int                              @default(1)
  nextMessageSequence   Int                              @default(1)
  lastMessageAt         DateTime?
  currentAssigneeUserId String?
  resolvedAt            DateTime?
  closedAt              DateTime?
  contentDeleteAfter    DateTime?
  contentDeletedAt      DateTime?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  requester             UserAccount                      @relation("SupportRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  currentAssignee       UserAccount?                     @relation("SupportCurrentAssignee", fields: [currentAssigneeUserId], references: [id], onDelete: SetNull)
  messages              SupportMessage[]
  assignments           SupportAssignment[]
  internalNotes         SupportInternalNote[]
  history               SupportConversationHistory[]
  notificationOutbox    EmailOutbox[]
  connectionProposals   ProfessionalConnectionProposal[]

  @@index([requesterUserId, updatedAt(sort: Desc), id])
  @@index([state, updatedAt, id])
  @@index([currentAssigneeUserId, state, updatedAt])
  @@index([contentDeleteAfter, contentDeletedAt])
}

model SupportMessage {
  id                String                   @id @default(cuid())
  conversationId    String
  sequence          Int
  senderKind        SupportMessageSenderKind
  senderUserId      String
  clientOperationId String
  content           String                   @db.Text
  createdAt         DateTime                 @default(now())
  conversation      SupportConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            UserAccount              @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@unique([conversationId, sequence])
  @@unique([senderUserId, clientOperationId])
  @@index([conversationId, sequence(sort: Desc)])
}

model SupportAssignment {
  id                    String                      @id @default(cuid())
  conversationId        String
  assigneeAdminUserId   String
  assignedByAdminUserId String
  assignedAt            DateTime                    @default(now())
  endedAt               DateTime?
  endReason             SupportAssignmentEndReason?
  conversation          SupportConversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignee              UserAccount                 @relation("SupportAssignmentAssignee", fields: [assigneeAdminUserId], references: [id], onDelete: Restrict)
  assignedBy            UserAccount                 @relation("SupportAssignmentActor", fields: [assignedByAdminUserId], references: [id], onDelete: Restrict)

  @@index([conversationId, assignedAt(sort: Desc)])
  @@index([assigneeAdminUserId, endedAt])
}

model SupportInternalNote {
  id                String              @id @default(cuid())
  conversationId    String
  authorAdminUserId String
  normalizedText    String              @db.Text
  createdAt         DateTime            @default(now())
  conversation      SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author            UserAccount         @relation(fields: [authorAdminUserId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
}

model SupportConversationHistory {
  id                      String                    @id @default(cuid())
  conversationId          String
  actorUserId             String?
  action                  String                    @db.VarChar(80)
  priorState              SupportConversationState?
  resultingState          SupportConversationState
  resultingVersion        Int
  assignmentReason        String?                   @db.VarChar(80)
  priorAssigneeUserId     String?
  resultingAssigneeUserId String?
  occurredAt              DateTime                  @default(now())
  conversation            SupportConversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, occurredAt])
}

model MessagingConversation {
  id                       String                              @id @default(cuid())
  participantLowId         String
  participantHighId        String
  contextType              MessagingConversationContextType
  contextReference         String
  applicationId            String?
  companyId                String?
  professionalConnectionId String?
  archivedAt               DateTime?
  archiveReason            MessagingConversationArchiveReason?
  nextMessageSequence      Int                                 @default(1)
  lastMessageSequence      Int?
  lastMessageAt            DateTime?
  createdAt                DateTime                            @default(now())
  updatedAt                DateTime                            @updatedAt
  participantLow           UserAccount                         @relation("MessagingConversationLow", fields: [participantLowId], references: [id], onDelete: Restrict)
  participantHigh          UserAccount                         @relation("MessagingConversationHigh", fields: [participantHighId], references: [id], onDelete: Restrict)
  application              JobApplication?                     @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  company                  Company?                            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  professionalConnection   ProfessionalConnection?             @relation(fields: [professionalConnectionId], references: [id], onDelete: Restrict)
  participants             MessagingConversationParticipant[]
  messages                 MessagingMessage[]
  reports                  MessagingReport[]

  @@unique([participantLowId, participantHighId, contextType, contextReference])
  @@index([participantLowId, lastMessageAt(sort: Desc), id])
  @@index([participantHighId, lastMessageAt(sort: Desc), id])
  @@index([applicationId])
  @@index([companyId])
  @@index([professionalConnectionId])
  @@index([archivedAt, archiveReason])
}

model MessagingConversationParticipant {
  conversationId   String
  userId           String
  lastReadSequence Int                   @default(0)
  lastReadAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  conversation     MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             UserAccount           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId, updatedAt(sort: Desc)])
}

model MessagingMessage {
  id                 String                @id @default(cuid())
  conversationId     String
  sequence           Int
  senderId           String
  clientOperationId  String
  content            String                @db.Text
  createdAt          DateTime              @default(now())
  conversation       MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender             UserAccount           @relation(fields: [senderId], references: [id], onDelete: Restrict)
  evidenceForReports MessagingReport[]     @relation("MessagingReportEvidence")

  @@unique([conversationId, sequence])
  @@unique([senderId, clientOperationId])
  @@index([conversationId, sequence(sort: Desc)])
}

model UserMessagingBlock {
  blockerUserId String
  blockedUserId String
  createdAt     DateTime    @default(now())
  blocker       UserAccount @relation("MessagingBlocker", fields: [blockerUserId], references: [id], onDelete: Restrict)
  blocked       UserAccount @relation("MessagingBlocked", fields: [blockedUserId], references: [id], onDelete: Restrict)

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId, blockerUserId])
}

model MessagingReport {
  id                       String                       @id @default(cuid())
  reporterUserId           String
  targetUserId             String
  conversationId           String
  targetType               MessagingReportTargetType
  evidenceMessageId        String?
  category                 ModerationReportCategory
  normalizedDetail         String?
  state                    ModerationReportState        @default(PENDING_REVIEW)
  assignedAdminUserId      String?
  handledByAdminUserId     String?
  enforcementCorrelationId String?                      @db.VarChar(128)
  version                  Int                          @default(1)
  unresolvedKey            String?                      @unique
  handledAt                DateTime?
  preserveUntil            DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  reporter                 UserAccount                  @relation("MessagingReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  target                   UserAccount                  @relation("MessagingTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  assignedAdmin            UserAccount?                 @relation("MessagingReportAssignee", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  handledByAdmin           UserAccount?                 @relation("MessagingReportHandler", fields: [handledByAdminUserId], references: [id], onDelete: SetNull)
  conversation             MessagingConversation        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  evidenceMessage          MessagingMessage?            @relation("MessagingReportEvidence", fields: [evidenceMessageId], references: [id], onDelete: SetNull)
  reviewEvents             MessagingReportReviewEvent[]
  privateNotes             MessagingReportPrivateNote[]

  @@index([reporterUserId, createdAt(sort: Desc)])
  @@index([conversationId, state, createdAt])
  @@index([state, createdAt, id])
  @@index([assignedAdminUserId, state, createdAt, id])
  @@index([preserveUntil])
}

model MessagingReportReviewEvent {
  id                       String                @id @default(cuid())
  reportId                 String
  actorAdminUserId         String
  action                   String                @db.VarChar(80)
  priorState               ModerationReportState
  resultingState           ModerationReportState
  resultingVersion         Int
  enforcementCorrelationId String?               @db.VarChar(128)
  occurredAt               DateTime              @default(now())
  report                   MessagingReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorAdmin               UserAccount           @relation("MessagingReportReviewActor", fields: [actorAdminUserId], references: [id], onDelete: Restrict)

  @@unique([reportId, resultingVersion])
  @@index([reportId, occurredAt, id])
  @@index([actorAdminUserId, occurredAt])
}

model MessagingReportPrivateNote {
  id                String          @id @default(cuid())
  reportId          String
  authorAdminUserId String
  normalizedText    String          @db.VarChar(2000)
  createdAt         DateTime        @default(now())
  report            MessagingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorAdmin       UserAccount      @relation("MessagingReportNoteAuthor", fields: [authorAdminUserId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt, id])
}

model ApplicationStageEvent {
  id                     String                    @id @default(cuid())
  applicationId          String
  fromStage              ApplicationStage?
  toStage                ApplicationStage
  actorUserId            String?
  actorType              ApplicationStageActorType
  reasonCode             String?
  candidateVisibleReason String?
  candidateVisible       Boolean                   @default(true)
  occurredAt             DateTime                  @default(now())
  applicationVersion     Int
  metadata               Json?
  application            JobApplication            @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, applicationVersion])
  @@index([applicationId, occurredAt, id])
  @@index([actorUserId, occurredAt])
}

model ApplicationAnswer {
  id               String              @id @default(cuid())
  applicationId    String
  questionId       String
  questionSnapshot Json
  answer           Json
  createdAt        DateTime            @default(now())
  application      JobApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question         ApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([applicationId, questionId])
  @@index([questionId])
}

model RecruitmentNotificationWork {
  id              String                          @id @default(cuid())
  applicationId   String
  audience        RecruitmentNotificationAudience
  kind            RecruitmentNotificationKind
  targetReference String
  payloadRef      Json
  idempotencyKey  String                          @unique
  status          OutboxStatus                    @default(PENDING)
  attempts        Int                             @default(0)
  nextAttemptAt   DateTime                        @default(now())
  safeErrorCode   String?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  application     JobApplication                  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([applicationId])
}

model CvAccountQuota {
  accountId     String      @id
  reservedBytes Int         @default(0)
  retainedBytes Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  account       UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model CvUpload {
  id                         String                @id @default(cuid())
  accountId                  String
  profileId                  String
  documentKind               CvDocumentKind
  parserClass                CvParserClass
  status                     CvUploadStatus        @default(AWAITING_CONTENT)
  declaredMediaType          String
  declaredBytes              Int
  actualBytes                Int?
  quotaReservationBytes      Int
  quotaReservationRemaining  Int
  sourceSha256               Bytes?
  displayFilenameCiphertext  String?
  idempotencyDigest          Bytes
  createBindingDigest        Bytes
  failureCode                String?
  automaticScanAttemptsUsed  Int                   @default(0)
  candidateScanRetriesUsed   Int                   @default(0)
  automaticParseAttemptsUsed Int                   @default(0)
  candidateParseRetriesUsed  Int                   @default(0)
  contentReceivedAt          DateTime?
  contentInaccessibleAt      DateTime?
  expiresAt                  DateTime
  deleteAfter                DateTime?
  deletedAt                  DateTime?
  confirmedAt                DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  account                    UserAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profile                    CandidateProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  artifacts                  CvStoredArtifact[]
  scanAssessments            CvScanAssessment[]
  extractions                CvExtraction[]
