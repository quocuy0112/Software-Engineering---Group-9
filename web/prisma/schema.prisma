  PROCESSING
  CLEAN
  INFECTED
  INDETERMINATE
  CANCELLED
}

enum CvExtractionStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CvParseStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CvParseTrigger {
  INITIAL
  AUTOMATIC_RETRY
  CANDIDATE_RETRY
}

enum CvRetryStage {
  SCAN
  PARSE
}

enum CvDraftStatus {
  EDITABLE
  CONFIRMED
  DELETED
  EXPIRED
}

enum CvConsentAction {
  GRANTED
  REVOKED
}

enum OcrProcessingPurpose {
  CV_IMPORT
  JOB_IMAGE_SEARCH
}

enum OcrAttemptStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  PARTIAL_REVIEW_REQUIRED
  FAILED
  CANCELLED
}

enum OcrUnitKind {
  PDF_PAGE
  DOCX_BODY_IMAGE
  SEARCH_IMAGE
}

enum OcrUnitStatus {
  NATIVE_SUFFICIENT
  OCR_SUCCEEDED
  NON_TEXT
  LOW_CONFIDENCE
  CONFLICT
  DEDUPLICATED
  EXCLUDED
  UNSUPPORTED
  FAILED
}

enum OcrSourceMethod {
  NATIVE
  OCR
  NATIVE_AND_OCR
  NONE
}

enum OcrAnchorQuality {
  EXACT
  APPROXIMATE
  PAGE_ONLY
  NOT_APPLICABLE
}

enum SearchActorClass {
  VISITOR
  AUTHENTICATED
}

enum SearchImageStatus {
  AWAITING_CONTENT
  SCAN_QUEUED
  SCANNING
  DECODE_QUEUED
  DECODING
  OCR_QUEUED
  OCR_PROCESSING
  AWAITING_CONSENT
  INTERPRET_QUEUED
  INTERPRETING
  RESULT_READY
  FALLBACK_READY
  VALIDATION_FAILED
  INFECTED
  SCAN_FAILED
  DECODE_FAILED
  OCR_FAILED
