generator client {
  provider = "prisma-client"
  output   = "../src/backend/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountState {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  ACCOUNT_RECOVERY_CONFIRMATION
}

enum TokenStatus {
  ACTIVE
  CONSUMED
  SUPERSEDED
  EXPIRED
}

enum ChallengePurpose {
  PASSWORD_LOGIN_2FA
  RECENT_AUTH
}

enum PasswordResetOperationStatus {
  CLAIMED
  PASSWORD_UPDATED
  SESSIONS_REVOKED
  CHALLENGES_INVALIDATED
  NOTIFICATION_ENQUEUED
  FAILED_RETRYABLE
  FINALIZED
}

enum PasswordResetFailureCode {
  PASSWORD_UPDATE_FAILED
  SESSION_REVOCATION_FAILED
  CHALLENGE_INVALIDATION_FAILED
  NOTIFICATION_ENQUEUE_FAILED
  AUDIT_FINALIZATION_FAILED
  OPERATION_FINALIZATION_FAILED
}

enum FullAccountRecoveryStatus {
  CONFIRMED_HOLD
  CANCELLED
  COMPLETING
  COMPLETED
}

enum FullAccountRecoveryFailureCode {
  HOLD_SESSION_REVOCATION_FAILED
  HOLD_CHALLENGE_INVALIDATION_FAILED
  HOLD_NOTIFICATION_ENQUEUE_FAILED
  PASSWORD_UPDATE_FAILED
  TWO_FACTOR_DISABLE_FAILED
  SESSION_REVOCATION_FAILED
  CHALLENGE_INVALIDATION_FAILED
  NOTIFICATION_ENQUEUE_FAILED
  AUDIT_FINALIZATION_FAILED
  OPERATION_FINALIZATION_FAILED
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum EmailKind {
  VERIFY_EMAIL
  EMAIL_CHANGE_VERIFY
  RESET_PASSWORD
  PASSWORD_CHANGED
  SECURITY_ALERT
  APPLICATION_STAGE_CHANGED
}

enum PreferenceLanguage {
  VI
  EN
}

enum EmailChangeStatus {
  PENDING
  SUPERSEDED
  CONSUMED
  EXPIRED
  CONFLICTED
}

enum PasswordChangeOperationStatus {
  INTENT_RECORDED
  PASSWORD_UPDATED
  OTHER_SESSIONS_REVOKED
  FAILED_RETRYABLE
  FINALIZED
}

enum PasswordChangeFailureCode {
  PASSWORD_UPDATE_FAILED
  SESSION_REVOCATION_FAILED
  SESSION_VERIFICATION_FAILED
  NOTIFICATION_ENQUEUE_FAILED
  AUDIT_FINALIZATION_FAILED
  OPERATION_FINALIZATION_FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  RETRYABLE
  DEAD
}

enum JobPostingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  CLOSED
  EXPIRED
  REJECTED
  REMOVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum SalaryPeriod {
  HOUR
  MONTH
  YEAR
}

enum ApplicationQuestionKind {
  TEXT
  BOOLEAN
  SINGLE_CHOICE
}

enum JobReportReason {
  FRAUD
  MISLEADING
  DUPLICATE
  DISCRIMINATORY
  INAPPROPRIATE
  OTHER
}

enum JobReportStatus {
  PENDING_REVIEW
  RESOLVED
  DISMISSED
}

enum ApplicationStage {
  APPLIED
  VIEWED
  SHORTLISTED
  INTERVIEWING
  OFFERED
  HIRED
  OFFER_DECLINED
  REJECTED
  WAITLISTED
}

enum ApplicationScoringStatus {
  NOT_REQUESTED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RecruitmentNotificationAudience {
  CANDIDATE
  COMPANY
}

enum RecruitmentNotificationKind {
  APPLICATION_SUBMITTED
  APPLICATION_RECEIVED
  APPLICATION_STAGE_CHANGED
}

enum CompanyMembershipRole {
  OWNER
  HR_MANAGER
  RECRUITER
  HIRING_MANAGER
}

enum CompanyMembershipStatus {
  ACTIVE
  SUSPENDED
}

enum ApplicationStageActorType {
  CANDIDATE
  RECRUITER
  SYSTEM_MIGRATION
}

enum CvDocumentKind {
  PDF
  DOCX
}

enum CvParserClass {
  DETERMINISTIC_INTERNAL
  EXTERNAL_OPENAI
}

enum CvUploadStatus {
  AWAITING_CONTENT
  VALIDATION_QUEUED
  SCAN_QUEUED
  SCANNING
  EXTRACTION_QUEUED
  EXTRACTING
  AWAITING_CONSENT
  PARSE_QUEUED
  PARSING
  REVIEW_READY
  VALIDATION_FAILED
  INFECTED
  SCAN_FAILED
  EXTRACTION_FAILED
  PARSE_FAILED
  CONFIRMED
  CANCELLED
  DELETED
  EXPIRED
