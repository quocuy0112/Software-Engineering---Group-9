  updatedAt             DateTime                   @updatedAt
  query                 SearchImageQuery           @relation(fields: [queryId], references: [id], onDelete: Cascade)
  scanSources           SearchScanAssessment[]     @relation("SearchScanSource")
  decodeSources         SearchImageDecodeAttempt[] @relation("SearchDecodeSource")
  normalizedDecode      SearchImageDecodeAttempt?  @relation("SearchDecodeNormalized")
  ocrTextIntentAttempts SearchIntentAttempt[]      @relation("SearchIntentOcrText")
  intentResultAttempt   SearchIntentAttempt?       @relation("SearchIntentResult")

  @@unique([queryId, kind])
  @@index([status, deleteAfter, deleteBy, deleteLeaseExpiresAt], map: "SearchStoredArtifact_delete_claim_idx")
}

model SearchScanAssessment {
  id                   String                     @id @default(cuid())
  queryId              String
  sourceArtifactId     String
  attemptNumber        Int
  status               SearchScanStatus           @default(QUEUED)
  engineName           String?
  engineVersion        String?
  signatureVersion     String?
  signaturePublishedAt DateTime?
  failureCode          String?
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                   @default(now())
  query                SearchImageQuery           @relation(fields: [queryId], references: [id], onDelete: Cascade)
  sourceArtifact       SearchStoredArtifact       @relation("SearchScanSource", fields: [sourceArtifactId], references: [id], onDelete: Cascade)
  decodeAttempts       SearchImageDecodeAttempt[]

  @@unique([queryId, attemptNumber])
  @@index([status, leaseExpiresAt, createdAt], map: "SearchScanAssessment_claim_idx")
}

model SearchImageDecodeAttempt {
  id                   String                @id @default(cuid())
  queryId              String
  sourceArtifactId     String
  scanAssessmentId     String
  normalizedArtifactId String?               @unique
  attemptNumber        Int
  status               SearchDecodeStatus    @default(QUEUED)
  normalizerName       String?
  normalizerVersion    String?
  rulesVersion         String?
  detectedFormat       String?
  width                Int?
  height               Int?
  decodedPixels        Int?
  frameCount           Int?
  metadataRemoved      Boolean?
  failureCode          String?
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime              @default(now())
  query                SearchImageQuery      @relation(fields: [queryId], references: [id], onDelete: Cascade)
  sourceArtifact       SearchStoredArtifact  @relation("SearchDecodeSource", fields: [sourceArtifactId], references: [id], onDelete: Cascade)
  scanAssessment       SearchScanAssessment  @relation(fields: [scanAssessmentId], references: [id], onDelete: Cascade)
  normalizedArtifact   SearchStoredArtifact? @relation("SearchDecodeNormalized", fields: [normalizedArtifactId], references: [id], onDelete: SetNull)

  @@unique([queryId, attemptNumber])
  @@index([status, leaseExpiresAt, createdAt], map: "SearchImageDecodeAttempt_claim_idx")
}

model SearchIntentAttempt {
  id                     String                   @id @default(cuid())
  queryId                String
  ocrAttemptId           String                   @unique
  ocrTextArtifactId      String
  resultArtifactId       String?                  @unique
  consentEventId         String?
  attemptNumber          Int
  status                 SearchIntentStatus       @default(QUEUED)
  interpreterClass       SearchInterpreterClass
  provider               String
  model                  String
  purposeVersion         String
  inputVersion           String
  instructionVersion     String
  schemaVersion          String
  selectionPolicyVersion String
  proposalCount          Int?
  autoSelectedCount      Int?
  suggestedCount         Int?
  discardedCount         Int?
  providerRequestIdHmac  Bytes?
  failureCode            String?
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime                 @default(now())
  query                  SearchImageQuery         @relation(fields: [queryId], references: [id], onDelete: Cascade)
  ocrAttempt             OcrProcessingAttempt     @relation(fields: [ocrAttemptId], references: [id], onDelete: Cascade)
  ocrTextArtifact        SearchStoredArtifact     @relation("SearchIntentOcrText", fields: [ocrTextArtifactId], references: [id], onDelete: Cascade)
  resultArtifact         SearchStoredArtifact?    @relation("SearchIntentResult", fields: [resultArtifactId], references: [id], onDelete: SetNull)
  consentEvent           SearchProcessingConsent? @relation(fields: [consentEventId], references: [id], onDelete: SetNull)

  @@unique([queryId, attemptNumber])
  @@index([status, leaseExpiresAt, createdAt], map: "SearchIntentAttempt_claim_idx")
}

model SearchProcessingConsent {
  id                         String                    @id @default(cuid())
  queryId                    String
  accountId                  String?
  actorClass                 SearchActorClass
  action                     SearchConsentAction
  supersedesConsentId        String?
  provider                   String
  interpreterClass           SearchInterpreterClass
  model                      String
  purposeVersion             String
  noticeVersion              String
  consentTextVersion         String
  retentionDisclosureVersion String
  idempotencyDigest          Bytes?
  occurredAt                 DateTime
  createdAt                  DateTime                  @default(now())
  query                      SearchImageQuery          @relation(fields: [queryId], references: [id], onDelete: Cascade)
  account                    UserAccount?              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  supersedesConsent          SearchProcessingConsent?  @relation("SearchConsentChain", fields: [supersedesConsentId], references: [id], onDelete: SetNull)
  supersededBy               SearchProcessingConsent[] @relation("SearchConsentChain")
  intentAttempts             SearchIntentAttempt[]

  @@unique([queryId, idempotencyDigest])
  @@index([queryId, occurredAt(sort: Desc)])
  @@index([accountId, occurredAt(sort: Desc)])
  @@index([supersedesConsentId])
}

model ImageSearchAdmissionEvent {
  id            String                      @id @default(cuid())
  queryId       String
  subjectKind   ImageSearchAdmissionSubject
  subjectDigest Bytes
  keyVersion    Int
  admittedAt    DateTime
  expiresAt     DateTime
  createdAt     DateTime                    @default(now())
  query         SearchImageQuery            @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@unique([queryId, subjectKind])
  @@index([subjectKind, subjectDigest, admittedAt], map: "ImageSearchAdmissionEvent_subject_window_idx")
  @@index([expiresAt])
}

/// Content-free, cross-process readiness evidence. Web admission reads these
/// rows; only cleanup, reconciliation, and the production preflight writer may
/// refresh their respective component.
model ImageSearchOperationalEvidence {
  component       String   @id
  evidenceVersion String
  evidenceDigest  Bytes?
  succeededAt     DateTime
  validUntil      DateTime
  updatedAt       DateTime @updatedAt

  @@index([validUntil])
}
