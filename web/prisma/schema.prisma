model UserAccount {
  id                             String                                  @id
  name                           String
  email                          String                                  @unique
  normalizedEmail                String                                  @unique
  emailVerified                  Boolean                                 @default(false)
  image                          String?
  state                          AccountState                            @default(PENDING_VERIFICATION)
  version                        Int                                     @default(1)
  twoFactorEnabled               Boolean                                 @default(false)
  stateChangedAt                 DateTime                                @default(now())
  deletedAt                      DateTime?
  createdAt                      DateTime                                @default(now())
  updatedAt                      DateTime                                @updatedAt
  accounts                       AuthProviderAccount[]
  sessions                       Session[]
  verifications                  Verification[]
  twoFactor                      TwoFactor?
  candidateIdentity              CandidateIdentity?
  securityTokens                 SecurityToken[]
  passwordResetOperations        PasswordResetOperation[]
  fullAccountRecoveryOperations  FullAccountRecoveryOperation[]
  challenges                     AuthenticationChallenge[]
  outbox                         EmailOutbox[]
  preferences                    AccountPreferences?
  jobWorkspaceState              UserJobWorkspaceState?
  emailChangeRequests            EmailChangeRequest[]
  passwordChangeAttemptWindow    PasswordChangeAttemptWindow?
  passwordChangeOperations       PasswordChangeOperation[]
  savedJobs                      SavedJob[]
  jobReports                     JobReport[]
  cvQuota                        CvAccountQuota?
  cvUploads                      CvUpload[]
  cvStoredArtifacts              CvStoredArtifact[]
  cvScanAssessments              CvScanAssessment[]
  cvExtractions                  CvExtraction[]
  cvParseJobs                    CvParseJob[]
  cvRetryRequests                CvRetryRequest[]
  cvDrafts                       CvDraft[]
  cvConsentEvents                CvProcessingConsent[]
  cvConfirmations                CvImportConfirmation[]
  imageSearchQueries             SearchImageQuery[]
  imageSearchConsents            SearchProcessingConsent[]
  companyMemberships             CompanyMembership[]
  platformAdministratorGrants    PlatformAdministratorGrant[]
  recruiterVerificationRequests  RecruiterVerificationRequest[]
  employerVerificationPreparation EmployerVerificationPreparation?
  businessRegistrySnapshots      BusinessRegistryLookupSnapshot[]
  companyEmailChallenges         CompanyContactEmailChallenge[]
  submittedModerationReports     ModerationReport[]                      @relation("ModerationReporter")
  professionalConnectionsLow     ProfessionalConnection[]                @relation("ProfessionalConnectionLow")
  professionalConnectionsHigh    ProfessionalConnection[]                @relation("ProfessionalConnectionHigh")
  professionalConnectionsRevoked ProfessionalConnection[]                @relation("ProfessionalConnectionRevoker")
  connectionProposalsLow         ProfessionalConnectionProposal[]        @relation("ConnectionProposalLow")
  connectionProposalsHigh        ProfessionalConnectionProposal[]        @relation("ConnectionProposalHigh")
  connectionProposalsCreated     ProfessionalConnectionProposal[]        @relation("ConnectionProposalCreator")
  connectionProposalDecisions    ProfessionalConnectionDecision[]        @relation("ConnectionProposalDecisionParticipant")
  connectionProposalHistory      ProfessionalConnectionProposalHistory[] @relation("ConnectionProposalHistoryActor")
  connectionNotifications        ProfessionalConnectionNotification[]    @relation("ConnectionNotificationRecipient")
  inAppNotifications             InAppNotification[]                     @relation("InAppNotificationRecipient")
  connectionCommandReceipts      ProfessionalConnectionCommandReceipt[]  @relation("ConnectionCommandActor")
  messagingConversationsLow      MessagingConversation[]                 @relation("MessagingConversationLow")
  messagingConversationsHigh     MessagingConversation[]                 @relation("MessagingConversationHigh")
  messagingParticipants          MessagingConversationParticipant[]
  messagingMessages              MessagingMessage[]
  messagingBlocksInitiated       UserMessagingBlock[]                    @relation("MessagingBlocker")
  messagingBlocksReceived        UserMessagingBlock[]                    @relation("MessagingBlocked")
  submittedMessagingReports      MessagingReport[]                       @relation("MessagingReporter")
  targetedMessagingReports       MessagingReport[]                       @relation("MessagingTarget")
  assignedMessagingReports       MessagingReport[]                       @relation("MessagingReportAssignee")
  handledMessagingReports        MessagingReport[]                       @relation("MessagingReportHandler")
  messagingReportReviewEvents    MessagingReportReviewEvent[]            @relation("MessagingReportReviewActor")
  messagingReportPrivateNotes    MessagingReportPrivateNote[]            @relation("MessagingReportNoteAuthor")
  supportConversationsRequested  SupportConversation[]                   @relation("SupportRequester")
  supportConversationsAssigned   SupportConversation[]                   @relation("SupportCurrentAssignee")
  supportMessages                SupportMessage[]
  supportAssignmentsReceived     SupportAssignment[]                     @relation("SupportAssignmentAssignee")
  supportAssignmentsMade         SupportAssignment[]                     @relation("SupportAssignmentActor")
  supportInternalNotes           SupportInternalNote[]

  @@index([state, id])
  @@index([state, createdAt(sort: Desc), id])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_name_trgm_idx")
  @@index([normalizedEmail(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_normalizedEmail_trgm_idx")
  @@map("user")
}

model AuthProviderAccount {
  id                    String      @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  user                  UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id                    String                       @id
  token                 String                       @unique
  userId                String
  expiresAt             DateTime
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  ipAddress             String?
  userAgent             String?
  lastActivityAt        DateTime                     @default(now())
  absoluteExpiresAt     DateTime
  revokedAt             DateTime?
  revocationReason      String?
  user                  UserAccount                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  administratorPolicies AdministratorSessionPolicy[]

  @@index([userId, expiresAt])
  @@index([userId, lastActivityAt])
  @@index([absoluteExpiresAt])
  @@map("session")
}

model Verification {
  id         String       @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  userId     String?
  user       UserAccount? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String      @id
  secret                  String
  backupCodes             String
  userId                  String      @unique
  verified                Boolean     @default(true)
  failedVerificationCount Int         @default(0)
  lockedUntil             DateTime?
  user                    UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("twoFactor")
}

model CandidateIdentity {
  userId          String            @id
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            UserAccount       @relation(fields: [userId], references: [id], onDelete: Restrict)
  profile         CandidateProfile?
  cvs             CandidateCv[]
  jobApplications JobApplication[]
}

model CandidateProfile {
  id              String                  @id @default(cuid())
  candidateUserId String                  @unique
  headline        String?
  summary         String?
  phone           String?
  location        String?
  revision        Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  candidate       CandidateIdentity       @relation(fields: [candidateUserId], references: [userId], onDelete: Cascade)
  experiences     ProfileExperience[]
  education       ProfileEducation[]
  skills          CandidateProfileSkill[]
  socialLinks     SocialLink[]
  cvUploads       CvUpload[]
  cvDrafts        CvDraft[]
  cvConfirmations CvImportConfirmation[]

  @@index([candidateUserId])
}

model ProfileExperience {
  id          String           @id @default(cuid())
  profileId   String
  title       String
  company     String
  description String?
  startDate   DateTime         @db.Date
  endDate     DateTime?        @db.Date
  isCurrent   Boolean
  position    Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, position])
  @@index([profileId])
}

model ProfileEducation {
  id          String           @id @default(cuid())
  profileId   String
  institution String
  degree      String
  field       String?
  startDate   DateTime         @db.Date
  endDate     DateTime?        @db.Date
  isCurrent   Boolean
  position    Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, position])
  @@index([profileId])
}

model Skill {
  id             String                  @id @default(cuid())
  name           String
  normalizedName String                  @unique
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  profiles       CandidateProfileSkill[]
  jobPostings    JobPostingSkill[]
}

model CandidateProfileSkill {
  profileId   String
  skillId     String
  displayName String
  position    Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([profileId, skillId])
  @@unique([profileId, position])
  @@index([skillId])
}

model SocialLink {
  id            String           @id @default(cuid())
  profileId     String
  url           String
  normalizedUrl String
  position      Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  profile       CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, normalizedUrl])
  @@unique([profileId, position])
  @@index([profileId])
}

model AccountPreferences {
  userId                  String             @id
  language                PreferenceLanguage @default(VI)
  timezone                String             @default("Asia/Ho_Chi_Minh")
  applicationUpdatesEmail Boolean            @default(true)
  jobRecommendationsEmail Boolean            @default(true)
  accountSecurityEmail    Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  user                    UserAccount        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserJobWorkspaceState {
  userId             String      @id
  hiddenJobIds       Json
  jobPreferences     Json
  savedFilterPresets Json
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailChangeRequest {
  id                      String            @id @default(cuid())
  userId                  String
  proposedEmail           String
  normalizedProposedEmail String
  tokenDigest             String            @unique
  status                  EmailChangeStatus @default(PENDING)
  expiresAt               DateTime
  consumedAt              DateTime?
  supersededAt            DateTime?
  resolvedAt              DateTime?
  idempotencyKey          String
  correlationId           String
  verificationOutboxId    String?           @unique
  oldEmailNoticeOutboxId  String?           @unique
  createdBySessionId      String
