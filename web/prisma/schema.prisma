model JobPosting {
  id                       String                @id @default(cuid())
  companyId                String
  slug                     String                @unique
  title                    String
  normalizedTitle          String
  summary                  String
  description              String
  responsibilities         String
  requirements             String
  benefits                 String?
  education                String?
  numberOfHires            Int?
  age                      String?
  location                 String
  normalizedLocation       String
  employmentType           EmploymentType
  experienceLevel          ExperienceLevel
  workArrangement          WorkArrangement
