* text=auto

*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf
*.prisma text eol=lf
*.sh text eol=lf

# Prisma's checked-in generator emits JSDoc padding spaces; preserve generated output.
web/src/backend/generated/prisma/** whitespace=-trailing-space

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
